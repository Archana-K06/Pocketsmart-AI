# PocketSmart AI — frontend configuration.
# The UI is server-rendered by the backend (Jinja2) and talks only to the backend's own
# API, so nothing here is required to run it.  These PUBLIC values are provided for any
# browser-side Supabase code you add later.
# NEVER put the Supabase secret key (sb_secret_...) in this file or in any browser code.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
