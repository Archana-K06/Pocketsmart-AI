# PocketSmart AI — backend configuration (Supabase PostgreSQL).
# Fill in every value that says YOUR_... , then start the app.  NEVER commit this file.

# --- Security ----------------------------------------------------------------
SECRET_KEY=
ENVIRONMENT=production
ACCESS_TOKEN_EXPIRE_MINUTES=30
SESSION_IDLE_MINUTES=30
COOKIE_SAMESITE=lax
# Leave empty: Secure cookies are switched on automatically in production.
COOKIE_SECURE=
# Browser origins allowed to call the API cross-origin (your deployed site URL).
CORS_ORIGINS=https://YOUR-SITE.vercel.app,http://localhost:8000

# --- Supabase project ----------------------------------------------------------
SUPABASE_PROJECT_NAME=YOUR_SUPABASE_PROJECT_NAME
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Publishable key (sb_publishable_...) — safe for browsers.  Not used by the backend's DB connection.
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Secret key (sb_secret_...) — SERVER ONLY, bypasses RLS.  Not used by the backend's DB connection.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# --- Database (THIS is what the backend connects with) -------------------------
# Supabase Dashboard -> Connect / Project Settings -> Database -> Connection string
# -> "Session pooler" (port 5432).  Use it on Render / Vercel / any host without IPv6.
# Replace [YOUR-PASSWORD] with the DATABASE password (Project Settings -> Database ->
# Reset database password) — this is NOT the publishable or secret API key.
# If the password contains @ / : # ? % characters, URL-encode them (e.g. @ -> %40).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
# Optional pool tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- Gemini AI (optional: without a key the app uses offline plans) ------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=25

# --- Local server ----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
